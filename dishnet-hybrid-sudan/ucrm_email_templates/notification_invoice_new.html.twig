<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1.0">
<title>New Invoice from DishNet Africa</title>
</head>
<body style="margin:0;padding:0;background:#f5f5f5;font-family:Helvetica,Arial,sans-serif;">

<table width="100%" cellpadding="0" cellspacing="0" border="0" style="background:#f5f5f5;padding:24px 12px;">
<tr><td align="center">
<table width="600" cellpadding="0" cellspacing="0" border="0" style="max-width:600px;width:100%;background:#ffffff;">

  <!-- ── HEADER: DishNet logo + red underline ── -->
  <tr>
    <td style="background:#ffffff;border-bottom:3px solid #D41C1C;padding:15px 24px;">
      <table width="100%" cellpadding="0" cellspacing="0" border="0">
        <tr>
          <td style="vertical-align:bottom;">
            <div style="font-size:26px;font-weight:900;color:#D41C1C;letter-spacing:-0.5px;line-height:1;font-family:Helvetica,Arial,sans-serif;">DishNet</div>
            <div style="height:4px;width:110px;background:#D41C1C;margin-top:3px;"></div>
            <div style="font-size:8px;color:#aaaaaa;margin-top:4px;letter-spacing:0.3px;font-family:Helvetica,Arial,sans-serif;">Internet Service Provider</div>
          </td>
          <td style="text-align:right;vertical-align:bottom;">
            <div style="font-size:9px;text-transform:uppercase;letter-spacing:2px;color:#bbbbbb;font-family:Helvetica,Arial,sans-serif;">NEW INVOICE</div>
            <div style="font-size:11px;color:#888888;margin-top:3px;font-family:Helvetica,Arial,sans-serif;">{{ "now"|date("d M Y") }}</div>
          </td>
        </tr>
      </table>
    </td>
  </tr>

  <!-- ── HERO BAND ── -->
  <tr>
    <td style="background:linear-gradient(135deg,#1d4ed8 0%,#1e3a8a 100%);padding:28px 24px 24px;position:relative;">
      <table width="100%" cellpadding="0" cellspacing="0" border="0">
        <tr>
          <td style="width:65%;vertical-align:middle;">
            <div style="font-size:9px;font-weight:700;letter-spacing:2px;text-transform:uppercase;color:rgba(255,255,255,0.5);margin-bottom:8px;font-family:Helvetica,Arial,sans-serif;">NEW INVOICE</div>
            <div style="font-size:24px;font-weight:400;color:#ffffff;line-height:1.2;margin-bottom:6px;font-family:Georgia,serif;">Hi <strong style="font-weight:700;">{{ client.firstName }}</strong>,</div>
            <div style="font-size:13px;color:rgba(255,255,255,0.72);line-height:1.5;font-family:Helvetica,Arial,sans-serif;">A new invoice has been generated for your account.</div>
          </td>
          <td style="width:35%;text-align:right;vertical-align:middle;">
            <div style="font-size:36px;font-weight:900;color:#ffffff;letter-spacing:-2px;line-height:1;font-family:Helvetica,Arial,sans-serif;">{{ invoice.totals.total }}</div>
            <div style="font-size:8px;color:rgba(255,255,255,0.5);font-weight:700;letter-spacing:1.5px;text-transform:uppercase;margin-top:3px;font-family:Helvetica,Arial,sans-serif;">DUE</div>
          </td>
        </tr>
      </table>
    </td>
  </tr>

  <!-- ── INVOICE META: 4-cell table ── -->
  <tr>
    <td style="background:#ffffff;padding:22px 24px 0;">
      <table width="100%" cellpadding="0" cellspacing="0" border="0">
        <tr>
          <td style="padding:8px 10px;border:1px solid #e0e0e0;width:25%;vertical-align:top;">
            <div style="font-size:7px;text-transform:uppercase;letter-spacing:1px;color:#bbbbbb;font-weight:700;margin-bottom:3px;font-family:Helvetica,Arial,sans-serif;">INVOICE</div>
            <div style="font-size:12px;font-weight:700;color:#141414;font-family:Helvetica,Arial,sans-serif;">{{ invoice.number }}</div>
          </td>
          <td style="padding:8px 10px;border:1px solid #e0e0e0;border-left:none;width:25%;vertical-align:top;">
            <div style="font-size:7px;text-transform:uppercase;letter-spacing:1px;color:#bbbbbb;font-weight:700;margin-bottom:3px;font-family:Helvetica,Arial,sans-serif;">AMOUNT DUE</div>
            <div style="font-size:16px;font-weight:900;color:#D41C1C;font-family:Helvetica,Arial,sans-serif;">{{ invoice.totals.total }}</div>
          </td>
          <td style="padding:8px 10px;border:1px solid #e0e0e0;border-left:none;width:25%;vertical-align:top;">
            <div style="font-size:7px;text-transform:uppercase;letter-spacing:1px;color:#bbbbbb;font-weight:700;margin-bottom:3px;font-family:Helvetica,Arial,sans-serif;">DUE DATE</div>
            <div style="font-size:12px;font-weight:700;color:#D41C1C;font-family:Helvetica,Arial,sans-serif;">{{ invoice.dueDate|date("d M Y") }}</div>
          </td>
          <td style="padding:8px 10px;border:1px solid #e0e0e0;border-left:none;width:25%;vertical-align:top;">
            <div style="font-size:7px;text-transform:uppercase;letter-spacing:1px;color:#bbbbbb;font-weight:700;margin-bottom:3px;font-family:Helvetica,Arial,sans-serif;">STATUS</div>
            <div style="font-size:11px;font-weight:700;color:#D41C1C;font-family:Helvetica,Arial,sans-serif;">UNPAID</div>
          </td>
        </tr>
      </table>
    </td>
  </tr>

  <!-- ── MESSAGE ── -->
  <tr>
    <td style="background:#ffffff;padding:18px 24px 0;">
      <p style="font-size:13px;color:#444444;line-height:1.8;margin:0;padding-left:13px;border-left:3px solid #1d4ed8;font-family:Georgia,serif;">
        Your new invoice <strong>{{ invoice.number }}</strong> for <strong>{{ invoice.totals.total }}</strong> is attached to this email. The invoice is due on <strong>{{ invoice.dueDate|date("d M Y") }}</strong>. Please ensure payment is made on or before the due date to avoid any service interruption.
      </p>
    </td>
  </tr>

  <!-- ── OUTSTANDING BALANCE ── -->
  {% if client.accountOutstanding and client.accountOutstanding != '$0.00' %}
  <tr>
    <td style="background:#ffffff;padding:14px 24px 0;">
      <table width="100%" cellpadding="0" cellspacing="0" border="0">
        <tr>
          <td style="background:#fef2f2;border:1px solid #fecaca;border-left:3px solid #D41C1C;padding:10px 14px;">
            <span style="font-size:12px;color:#7f1d1d;font-family:Helvetica,Arial,sans-serif;">
              <strong style="color:#D41C1C;">Total outstanding balance:</strong> {{ client.accountOutstanding }}
            </span>
          </td>
        </tr>
      </table>
    </td>
  </tr>
  {% endif %}

  <!-- ── PAY ONLINE CTA ── -->
  {% if organization.hasPaymentGateway and invoice.onlinePaymentLink %}
  <tr>
    <td style="background:#ffffff;padding:18px 24px 0;">
      <table width="100%" cellpadding="0" cellspacing="0" border="0">
        <tr>
          <td style="background:#F0FDF4;border:1px solid #BBF7D0;padding:16px;text-align:center;">
            <div style="font-size:9px;color:#065f46;margin-bottom:10px;font-weight:600;letter-spacing:0.3px;font-family:Helvetica,Arial,sans-serif;">Pay this invoice securely online</div>
            <a href="{{ invoice.onlinePaymentLink }}" style="display:inline-block;background:#059669;color:#ffffff;font-size:13px;font-weight:800;padding:12px 36px;border-radius:4px;text-decoration:none;letter-spacing:0.4px;text-transform:uppercase;font-family:Helvetica,Arial,sans-serif;">PAY NOW — {{ invoice.totals.total }}</a>
          </td>
        </tr>
      </table>
    </td>
  </tr>
  {% endif %}

  <!-- ── CLIENT ZONE LINK ── -->
  {% if client.hasClientZoneAccess %}
  <tr>
    <td style="background:#ffffff;padding:14px 24px 0;">
      <p style="font-size:11px;color:#888888;line-height:1.6;margin:0;font-family:Helvetica,Arial,sans-serif;">
        View your full invoice history and account balance in the <strong>Client Zone</strong>{% if organization.paymentSubscriptionsEnabled and not client.hasPaymentSubscription %}, where you can also set up automatic payments{% endif %}.
      </p>
    </td>
  </tr>
  {% endif %}

  <!-- ── PAYMENT TERMS ── -->
  <tr>
    <td style="background:#ffffff;padding:14px 24px 6px;">
      <table width="100%" cellpadding="0" cellspacing="0" border="0">
        <tr>
          <td style="border:1px solid #e0e0e0;border-left:3px solid #D41C1C;padding:8px 12px;">
            <span style="font-size:8px;color:#555555;line-height:1.65;font-family:Helvetica,Arial,sans-serif;">
              <strong style="color:#141414;">Payment Terms:</strong> Amount due is payable on or before the due date. Failure to pay may result in automatic service disconnection without further notice. Late payment attracts 5% penalty after 7 days. Reconnection fee: USD 25.
            </span>
          </td>
        </tr>
      </table>
    </td>
  </tr>

  <!-- ── COMPUTER GENERATED ── -->
  <tr>
    <td style="background:#ffffff;padding:8px 24px 18px;">
      <div style="font-size:8px;color:#bbbbbb;font-style:italic;font-family:Helvetica,Arial,sans-serif;">This is a computer generated notice — no signature required. Invoice is attached as PDF.</div>
    </td>
  </tr>

  <!-- ── HELP STRIP ── -->
  <tr>
    <td style="background:#f8f8f8;border-top:1px solid #f0f0f0;padding:16px 24px;">
      <table width="100%" cellpadding="0" cellspacing="0" border="0">
        <tr>
          <td style="width:46px;vertical-align:middle;">
            <div style="width:38px;height:38px;border-radius:50%;background:#fef2f2;text-align:center;line-height:38px;font-size:18px;">💬</div>
          </td>
          <td style="padding-left:12px;vertical-align:middle;">
            <div style="font-size:12px;font-weight:800;color:#141414;margin-bottom:2px;font-family:Helvetica,Arial,sans-serif;">Questions about this invoice?</div>
            <div style="font-size:11px;color:#888888;line-height:1.5;font-family:Helvetica,Arial,sans-serif;">Reply to this email &nbsp;·&nbsp; WhatsApp {{ organization.phone }} &nbsp;·&nbsp; {{ organization.email }}</div>
          </td>
        </tr>
      </table>
    </td>
  </tr>

  <!-- ── THANK YOU FOOTER ── -->
  <tr>
    <td style="background:#ffffff;padding:0 24px;">
      <table width="100%" cellpadding="0" cellspacing="0" border="0" style="border-top:1px solid #e8e8e8;">
        <tr>
          <td style="padding:11px 0;vertical-align:middle;">
            <div style="font-size:11px;font-weight:700;color:#141414;font-family:Helvetica,Arial,sans-serif;">Thank you for your business.</div>
            <div style="font-size:8px;color:#aaaaaa;margin-top:2px;font-family:Helvetica,Arial,sans-serif;">For queries, contact us at {{ organization.phone }} or {{ organization.email }}</div>
          </td>
          <td style="text-align:right;padding:11px 0;vertical-align:middle;">
            <div style="font-size:8px;color:#888888;font-family:Helvetica,Arial,sans-serif;">DishNet Africa Ltd.</div>
          </td>
        </tr>
      </table>
    </td>
  </tr>

  <!-- ── RED BAR + BOTTOM STRIP ── -->
  <tr><td style="height:2px;background:#D41C1C;font-size:0;line-height:0;">&nbsp;</td></tr>
  <tr>
    <td style="background:#ffffff;padding:0;">
      <table width="100%" cellpadding="0" cellspacing="0" border="0">
        <tr>
          <td style="padding:6px 24px;font-size:8px;color:#aaaaaa;font-family:Helvetica,Arial,sans-serif;">DishNet Africa Ltd &middot; South Sudan</td>
          <td style="padding:6px 24px;font-size:9px;color:#D41C1C;text-align:center;font-style:italic;font-weight:600;font-family:Helvetica,Arial,sans-serif;">Of course we can ...</td>
          <td style="padding:6px 24px;font-size:8px;color:#aaaaaa;text-align:right;font-family:Helvetica,Arial,sans-serif;">www.dishnetafrica.com</td>
        </tr>
      </table>
    </td>
  </tr>

</table>
</td></tr>
</table>

</body>
</html>
