<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1.0">
<title>Payment Received — DishNet Africa</title>
</head>
<body style="margin:0;padding:0;background:#f5f5f5;font-family:Helvetica,Arial,sans-serif;">

<table width="100%" cellpadding="0" cellspacing="0" border="0" style="background:#f5f5f5;padding:24px 12px;">
<tr><td align="center">
<table width="600" cellpadding="0" cellspacing="0" border="0" style="max-width:600px;width:100%;background:#ffffff;">

  <!-- ── HEADER ── -->
  <tr>
    <td style="background:#ffffff;border-bottom:3px solid #D41C1C;padding:15px 24px;">
      <table width="100%" cellpadding="0" cellspacing="0" border="0">
        <tr>
          <td style="vertical-align:bottom;">
            <div style="font-size:26px;font-weight:900;color:#D41C1C;letter-spacing:-0.5px;line-height:1;font-family:Helvetica,Arial,sans-serif;">DishNet</div>
            <div style="height:4px;width:110px;background:#D41C1C;margin-top:3px;"></div>
            <div style="font-size:8px;color:#aaaaaa;margin-top:4px;letter-spacing:0.3px;font-family:Helvetica,Arial,sans-serif;">Internet Service Provider</div>
          </td>
          <td style="text-align:right;vertical-align:bottom;">
            <div style="font-size:9px;text-transform:uppercase;letter-spacing:2px;color:#bbbbbb;font-family:Helvetica,Arial,sans-serif;">PAYMENT RECEIVED</div>
            <div style="font-size:11px;color:#888888;margin-top:3px;font-family:Helvetica,Arial,sans-serif;">{{ "now"|date("d M Y") }}</div>
          </td>
        </tr>
      </table>
    </td>
  </tr>

  <!-- ── HERO BAND — green for payment confirmed ── -->
  <tr>
    <td style="background:linear-gradient(135deg,#059669 0%,#065f46 100%);padding:28px 24px 24px;">
      <table width="100%" cellpadding="0" cellspacing="0" border="0">
        <tr>
          <td style="width:65%;vertical-align:middle;">
            <div style="font-size:9px;font-weight:700;letter-spacing:2px;text-transform:uppercase;color:rgba(255,255,255,0.5);margin-bottom:8px;font-family:Helvetica,Arial,sans-serif;">PAYMENT CONFIRMED</div>
            <div style="font-size:24px;font-weight:400;color:#ffffff;line-height:1.2;margin-bottom:6px;font-family:Georgia,serif;">Thank you, <strong style="font-weight:700;">{{ client.firstName }}</strong>!</div>
            <div style="font-size:13px;color:rgba(255,255,255,0.8);line-height:1.5;font-family:Helvetica,Arial,sans-serif;">Your payment has been received. Your service is active.</div>
          </td>
          <td style="width:35%;text-align:right;vertical-align:middle;">
            <div style="font-size:36px;font-weight:900;color:#ffffff;letter-spacing:-2px;line-height:1;font-family:Helvetica,Arial,sans-serif;">{{ payment.amount }}</div>
            <div style="font-size:8px;color:rgba(255,255,255,0.6);font-weight:700;letter-spacing:1.5px;text-transform:uppercase;margin-top:3px;font-family:Helvetica,Arial,sans-serif;">RECEIVED</div>
          </td>
        </tr>
      </table>
    </td>
  </tr>

  <!-- ── PAYMENT DETAILS ── -->
  <tr>
    <td style="background:#ffffff;padding:22px 24px 0;">
      <table width="100%" cellpadding="0" cellspacing="0" border="0">
        <tr>
          <td style="padding:8px 10px;border:1px solid #e0e0e0;width:33%;vertical-align:top;">
            <div style="font-size:7px;text-transform:uppercase;letter-spacing:1px;color:#bbbbbb;font-weight:700;margin-bottom:3px;font-family:Helvetica,Arial,sans-serif;">AMOUNT PAID</div>
            <div style="font-size:16px;font-weight:900;color:#059669;font-family:Helvetica,Arial,sans-serif;">{{ payment.amount }}</div>
          </td>
          <td style="padding:8px 10px;border:1px solid #e0e0e0;border-left:none;width:33%;vertical-align:top;">
            <div style="font-size:7px;text-transform:uppercase;letter-spacing:1px;color:#bbbbbb;font-weight:700;margin-bottom:3px;font-family:Helvetica,Arial,sans-serif;">DATE</div>
            <div style="font-size:12px;font-weight:700;color:#141414;font-family:Helvetica,Arial,sans-serif;">{{ payment.createdDate|date("d M Y") }}</div>
          </td>
          <td style="padding:8px 10px;border:1px solid #e0e0e0;border-left:none;width:34%;vertical-align:top;">
            <div style="font-size:7px;text-transform:uppercase;letter-spacing:1px;color:#bbbbbb;font-weight:700;margin-bottom:3px;font-family:Helvetica,Arial,sans-serif;">ACCOUNT STATUS</div>
            <div style="font-size:11px;font-weight:700;color:#059669;font-family:Helvetica,Arial,sans-serif;">&#10003; ALL CLEAR</div>
          </td>
        </tr>
      </table>
    </td>
  </tr>

  <!-- ── MESSAGE ── -->
  <tr>
    <td style="background:#ffffff;padding:18px 24px 0;">
      <p style="font-size:13px;color:#444444;line-height:1.8;margin:0;padding-left:13px;border-left:3px solid #059669;font-family:Georgia,serif;">
        We have successfully received your payment of <strong>{{ payment.amount }}</strong>. Your DishNet account is now up to date. A receipt is attached to this email for your records.
      </p>
    </td>
  </tr>

  <!-- ── REMAINING BALANCE ── -->
  {% if client.accountOutstanding and client.accountOutstanding != '$0.00' %}
  <tr>
    <td style="background:#ffffff;padding:14px 24px 0;">
      <table width="100%" cellpadding="0" cellspacing="0" border="0">
        <tr>
          <td style="background:#fef2f2;border:1px solid #fecaca;border-left:3px solid #D41C1C;padding:10px 14px;">
            <span style="font-size:12px;color:#7f1d1d;font-family:Helvetica,Arial,sans-serif;">
              <strong style="color:#D41C1C;">Remaining outstanding balance:</strong> {{ client.accountOutstanding }} — please settle this to keep your account fully current.
            </span>
          </td>
        </tr>
      </table>
    </td>
  </tr>
  {% else %}
  <tr>
    <td style="background:#ffffff;padding:14px 24px 0;">
      <table width="100%" cellpadding="0" cellspacing="0" border="0">
        <tr>
          <td style="background:#F0FDF4;border:1px solid #BBF7D0;border-left:3px solid #059669;padding:10px 14px;">
            <span style="font-size:12px;color:#065f46;font-family:Helvetica,Arial,sans-serif;">
              &#10003; <strong>Your account is fully settled.</strong> Thank you for keeping your account up to date.
            </span>
          </td>
        </tr>
      </table>
    </td>
  </tr>
  {% endif %}

  <tr>
    <td style="background:#ffffff;padding:14px 24px 18px;">
      <div style="font-size:8px;color:#bbbbbb;font-style:italic;font-family:Helvetica,Arial,sans-serif;">This is a computer generated receipt — no signature required. A full receipt is attached as PDF.</div>
    </td>
  </tr>

  <!-- ── HELP STRIP ── -->
  <tr>
    <td style="background:#f8f8f8;border-top:1px solid #f0f0f0;padding:16px 24px;">
      <table width="100%" cellpadding="0" cellspacing="0" border="0">
        <tr>
          <td style="width:46px;vertical-align:middle;">
            <div style="width:38px;height:38px;border-radius:50%;background:#f0fdf4;text-align:center;line-height:38px;font-size:18px;">✅</div>
          </td>
          <td style="padding-left:12px;vertical-align:middle;">
            <div style="font-size:12px;font-weight:800;color:#141414;margin-bottom:2px;font-family:Helvetica,Arial,sans-serif;">Need help with your account?</div>
            <div style="font-size:11px;color:#888888;line-height:1.5;font-family:Helvetica,Arial,sans-serif;">Reply to this email &nbsp;·&nbsp; WhatsApp {{ organization.phone }} &nbsp;·&nbsp; {{ organization.email }}</div>
          </td>
        </tr>
      </table>
    </td>
  </tr>

  <!-- ── FOOTER ── -->
  <tr>
    <td style="background:#ffffff;padding:0 24px;">
      <table width="100%" cellpadding="0" cellspacing="0" border="0" style="border-top:1px solid #e8e8e8;">
        <tr>
          <td style="padding:11px 0;vertical-align:middle;">
            <div style="font-size:11px;font-weight:700;color:#141414;font-family:Helvetica,Arial,sans-serif;">Thank you for your business.</div>
            <div style="font-size:8px;color:#aaaaaa;margin-top:2px;font-family:Helvetica,Arial,sans-serif;">For queries, contact us at {{ organization.phone }} or {{ organization.email }}</div>
          </td>
          <td style="text-align:right;padding:11px 0;vertical-align:middle;">
            <div style="font-size:8px;color:#888888;font-family:Helvetica,Arial,sans-serif;">DishNet Africa Ltd.</div>
          </td>
        </tr>
      </table>
    </td>
  </tr>
  <tr><td style="height:2px;background:#D41C1C;font-size:0;line-height:0;">&nbsp;</td></tr>
  <tr>
    <td style="background:#ffffff;padding:0;">
      <table width="100%" cellpadding="0" cellspacing="0" border="0">
        <tr>
          <td style="padding:6px 24px;font-size:8px;color:#aaaaaa;font-family:Helvetica,Arial,sans-serif;">DishNet Africa Ltd &middot; South Sudan</td>
          <td style="padding:6px 24px;font-size:9px;color:#D41C1C;text-align:center;font-style:italic;font-weight:600;font-family:Helvetica,Arial,sans-serif;">Of course we can ...</td>
          <td style="padding:6px 24px;font-size:8px;color:#aaaaaa;text-align:right;font-family:Helvetica,Arial,sans-serif;">www.dishnetafrica.com</td>
        </tr>
      </table>
    </td>
  </tr>

</table>
</td></tr>
</table>
</body>
</html>
